# ---- Data: contents are never committed (see data/README.md) --------------------------
# The raw-data manifest (data/raw_manifest.csv) IS tracked.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
!data/external/README.md

# ---- Outputs: regenerated by scripts; final versions are assembled in replication/ ------
outputs/*/*
!outputs/*/.gitkeep

# ---- Secrets / credentials ------------------------------------------------------------
.env
.env.*
*.key
*.pem
credentials*
secrets*

# ---- Python ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- OS / editors / sync clients -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
~$*
*.swp
.vscode/
.idea/
*conflicted copy*
.dropbox
.dropbox.attr
