# ---- Data: contents are never committed (see data/README.md) --------------------------
# The raw-data manifest (data/raw_manifest.csv) IS tracked.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
# LLM-assisted recognition classifications (data/interim/recognition/): these are this agent's own
# read-and-judge output, not reproducible by rerunning a deterministic script -- tracked like
# human-coded annotation data would be. See docs/measurement_protocol.md.
!data/interim/recognition/
!data/interim/recognition/*
data/processed/*
!data/processed/.gitkeep
# Hand-curated analytical tables (not mechanically regenerable; contain reliability/provenance
# judgments made during analysis, see docs/decision_log.md) ARE tracked:
!data/processed/industrial_crossover_candidates.csv
data/external/*
!data/external/.gitkeep
!data/external/README.md

# ---- Outputs: regenerated by scripts; final versions are assembled in replication/ ------
outputs/*/*
!outputs/*/.gitkeep
# Narrative reports and manuscripts are authored once, not mechanically regenerated -- tracked:
!outputs/reports/*
!outputs/manuscript/*
# outputs/*/* only reaches one level into each outputs subdirectory, so a nested pilot directory
# like outputs/exploratory/new_mechanisms/ is NOT caught by it and must be excluded explicitly,
# then have only its hand-authored reports (not its regenerable csv/png) re-included:
outputs/exploratory/new_mechanisms/*
!outputs/exploratory/new_mechanisms/*.md

# ---- Secrets / credentials ------------------------------------------------------------
.env
.env.*
*.key
*.pem
credentials*
secrets*

# ---- Python ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- OS / editors / sync clients -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
~$*
*.swp
.vscode/
.idea/
*conflicted copy*
.dropbox
.dropbox.attr

# ---- Large local provenance logs (summaries are tracked; see metadata/README.md) --------
metadata/download_log.csv
metadata/youtube_quota_log.csv

# ---- asean3 study: derived data and outputs follow the same rule (regenerated by scripts) ----
asean3/data/*
!asean3/data/.gitkeep
asean3/outputs/*/*
!asean3/outputs/*/.gitkeep
