@article{duque2018recognizing,
  author  = {Duque, Marina G.},
  title   = {Recognizing International Status: A Relational Approach},
  journal = {International Studies Quarterly},
  year    = {2018},
  volume  = {62},
  number  = {3},
  pages   = {577--592},
  doi     = {10.1093/isq/sqy001},
  note    = {Verified via publisher record and author CV (cosspp.fsu.edu), 2026-10-13. Winner,
             2019 APSA Political Networks Political Ties Award.}
}

@article{roren2019grading,
  author  = {R{\o}ren, P{\aa}l and Beaumont, Paul},
  title   = {Grading Greatness: Evaluating the Status Performance of the {BRICS}},
  journal = {Third World Quarterly},
  year    = {2019},
  volume  = {40},
  number  = {3},
  pages   = {429--450},
  note    = {Verified via University of Southern Denmark research portal, 2026-10-13. Uses
             diplomatic representation as a recognition proxy against a wealth-based status-
             resource index; treats resource-recognition gaps as requiring case-study explanation
             rather than statistical error.}
}

@article{kim2014developmentalist,
  author  = {Kim, Jongtae},
  title   = {South Korea's Developmentalist Worldview: Representations and Identities in the
             Discourse of \textit{Seonjinguk}},
  journal = {Asian Journal of Social Science},
  year    = {2014},
  volume  = {42},
  number  = {3--4},
  pages   = {383--408},
  doi     = {10.1163/15685314-04203007},
  note    = {Verified via ResearchGate listing and citation in Kim (2025, Pacific Focus),
             2026-10-13. Newspaper-editorial discourse analysis; argues Korean public discourse
             divides the world into seonjinguk (advanced) and marginalized "backward" categories,
             with Korea positioned as perpetually "on the threshold." Directly relevant to the
             self-positioning dimension of status perception in the challenger state, as distinct
             from the incumbent's recognition of the challenger.}
}

@article{kim2024status,
  author  = {Kim, Claudia Junghyun},
  title   = {Status Hierarchies and Stigma Shifting in International Relations},
  journal = {International Organization},
  year    = {2024},
  volume  = {78},
  number  = {4},
  pages   = {668--700},
  doi     = {10.1017/S0020818324000316},
  note    = {Verified via Cambridge Core and EconPapers, 2026-10-13. Introduces "stigma shifting":
             status-anxious states redirect stigma-induced inferiority by seeking identification
             with higher-status states and differentiation from lower-status ones. Applied to East
             Asia across colonial redress, nuclear disaster, and order-making. DIRECTLY maps to
             mechanism M5 (hierarchy reproduction) in docs/theoretical_framework.md -- the
             strongest single theoretical anchor found for the "states that struggled for
             recognition reproduce hierarchy toward newer challengers" strand of this project.}
}

@article{powers2023international,
  author  = {Powers, Ryan and Renshon, Jonathan},
  title   = {International Status Concerns and Domestic Support for Political Leaders},
  journal = {American Journal of Political Science},
  year    = {2023},
  volume  = {67},
  number  = {3},
  pages   = {732--747},
  doi     = {10.1111/ajps.12689},
  note    = {Verified via Wiley Online Library and authors' CVs, 2026-10-13. Seven preregistered
             survey experiments (EGAP 20180321AA) across four issue areas; shows expected status
             loss from foreign-policy outcomes lowers leader approval, and that publics reason
             about status in multidimensional, positional terms matching IR scholarship. Relevant
             to M4 (generational/public-opinion channel) and to motivating why perceived status
             matters for domestic politics, not only elite diplomacy.}
}

@article{kim2025geopolitics,
  author  = {Kim, Seongjo},
  title   = {Geopolitics, Status Perceptions, and Public Attitudes in {Korea--Japan} Relations},
  journal = {Asian Politics \& Policy},
  year    = {2025},
  doi     = {10.1111/aspp.70039},
  note    = {Verified via Wiley Online Library, 2026-10-13. Uses the 2022 Korea-Japan Joint
             Perception Survey (EAI/Genron). Key finding: favorability and economic
             interdependence predict status perceptions among Japanese respondents only; among
             Korean respondents, geopolitical factors (perceived China threat, US strategic
             importance) predict status perceptions in both directions. Directly establishes that
             the EAI/Genron survey series is a usable, precedented source for status-perception
             items (see docs/data_access_requirements.md) and that bilateral and regional channels
             should be modeled separately, not pooled.}
}

@article{renshon2016status,
  author  = {Renshon, Jonathan},
  title   = {Status Deficits and War},
  journal = {International Organization},
  year    = {2016},
  volume  = {70},
  number  = {3},
  pages   = {513--550},
  note    = {Found during verification search (not in the original named list), added 2026-10-13.
             Defines "status deficit" as the gap between a state's recognized diplomatic rank and
             its material-capability rank (COW CINC-based); status deficits, not rank per se,
             predict conflict initiation. "Status community" (local, not global, reference groups)
             is methodologically relevant to case/comparison-group selection in this project.}
}

@book{renshon2017fighting,
  author    = {Renshon, Jonathan},
  title     = {Fighting for Status: Hierarchy and Conflict in World Politics},
  publisher = {Princeton University Press},
  year      = {2017},
  note      = {Verified via ISSF/H-Diplo roundtable and Political Science Quarterly review,
               2026-10-13. Book-length development of renshon2016status.}
}

